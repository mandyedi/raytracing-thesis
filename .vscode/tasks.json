{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "qmake",
            "type": "process",
            "command": "C:/msys64/mingw64/bin/qmake-qt5.exe",
            "args": [ "-o", "build/Makefile", "raytracer.pro" ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": { "PATH": "C:\\msys64\\mingw64\\bin;${env:PATH}" }
            },
            "problemMatcher": []
        },
        {
            "label": "build debug",
            "type": "process",
            "command": "C:/msys64/mingw64/bin/mingw32-make.exe",
            "args": [ "-j8", "-f", "Makefile.Debug" ],
            "options": {
                "cwd": "${workspaceFolder}/build",
                "env": { "PATH": "C:\\msys64\\mingw64\\bin;${env:PATH}" }
            },
            "dependsOn": "qmake",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [ "relative", "${workspaceFolder}/build" ]
            },
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "build release",
            "type": "process",
            "command": "C:/msys64/mingw64/bin/mingw32-make.exe",
            "args": [ "-j8", "-f", "Makefile.Release" ],
            "options": {
                "cwd": "${workspaceFolder}/build",
                "env": { "PATH": "C:\\msys64\\mingw64\\bin;${env:PATH}" }
            },
            "dependsOn": "qmake",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [ "relative", "${workspaceFolder}/build" ]
            },
            "group": "build"
        }
    ]
}
