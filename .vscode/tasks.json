{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure debug",
            "type": "process",
            "command": "cmake",
            "args": [ "-S", ".", "-B", "build/debug", "-G", "MinGW Makefiles", "-DCMAKE_BUILD_TYPE=Debug" ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": { "PATH": "C:\\msys64\\mingw64\\bin;${env:PATH}" }
            },
            "problemMatcher": []
        },
        {
            "label": "build debug",
            "type": "process",
            "command": "cmake",
            "args": [ "--build", "build/debug", "-j", "8" ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": { "PATH": "C:\\msys64\\mingw64\\bin;${env:PATH}" }
            },
            "dependsOn": "configure debug",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": "absolute"
            },
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "configure release",
            "type": "process",
            "command": "cmake",
            "args": [ "-S", ".", "-B", "build/release", "-G", "MinGW Makefiles", "-DCMAKE_BUILD_TYPE=Release" ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": { "PATH": "C:\\msys64\\mingw64\\bin;${env:PATH}" }
            },
            "problemMatcher": []
        },
        {
            "label": "build release",
            "type": "process",
            "command": "cmake",
            "args": [ "--build", "build/release", "-j", "8" ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": { "PATH": "C:\\msys64\\mingw64\\bin;${env:PATH}" }
            },
            "dependsOn": "configure release",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": "absolute"
            },
            "group": "build"
        }
    ]
}
