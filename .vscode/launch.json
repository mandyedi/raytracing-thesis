{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug raytracer (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/raytracer.exe",
            "cwd": "${workspaceFolder}/build",
            "environment": [
                { "name": "PATH", "value": "C:\\msys64\\mingw64\\bin;${env:PATH}" }
            ],
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe",
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "externalConsole": false,
            "preLaunchTask": "build debug"
        },
        {
            "name": "Run raytracer (no breakpoints)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/raytracer.exe",
            "cwd": "${workspaceFolder}/build",
            "environment": [
                { "name": "PATH", "value": "C:\\msys64\\mingw64\\bin;${env:PATH}" }
            ],
            "console": "internalConsole",
            "preLaunchTask": "build debug"
        },
        {
            "name": "Run raytracer (release)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/release/raytracer.exe",
            "cwd": "${workspaceFolder}/build",
            "environment": [
                { "name": "PATH", "value": "C:\\msys64\\mingw64\\bin;${env:PATH}" }
            ],
            "console": "internalConsole",
            "preLaunchTask": "build release"
        }
    ]
}
